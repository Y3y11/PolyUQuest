# Copy to a secret-managed location outside Git before deployment.
BACKEND_IMAGE=polyuquest-backend:0.1.0
BACKEND_RUNTIME_PROFILE=remote
FRONTEND_IMAGE=polyuquest-frontend:0.1.0
API_PORT=8000
FRONTEND_PORT=3000

NEO4J_PASSWORD=replace-with-a-long-random-password
API_AUTH_KEYS=replace-with-hash-only-record-generated-by-security-cli

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-v4-flash

EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=replace-with-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

CORS_ALLOW_ORIGINS=https://knowledge.example.com
# Host path to the protected raw frontend reader key. On Linux use root:10001
# ownership and mode 0440; Compose mounts it at /run/secrets/bff_backend_api_key.
BFF_BACKEND_API_KEY_FILE=/etc/polyuquest/secrets/frontend-reader.key
BFF_ALLOWED_ORIGINS=https://knowledge.example.com
BFF_MAX_REQUEST_BYTES=65536
BFF_UPSTREAM_TIMEOUT_SECONDS=120
WORKER_SHUTDOWN_GRACE_SECONDS=30
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=1g
