# Copy to a secret-managed location outside Git before deployment.
BACKEND_IMAGE=polyuquest-backend:0.1.0
FRONTEND_IMAGE=polyuquest-frontend:0.1.0
API_PORT=8000
FRONTEND_PORT=3000

NEO4J_PASSWORD=replace-with-a-long-random-password
API_AUTH_KEYS=replace-with-hash-only-record-generated-by-security-cli

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-v4-flash

EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=replace-with-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

CORS_ALLOW_ORIGINS=https://knowledge.example.com
WORKER_SHUTDOWN_GRACE_SECONDS=30
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=1g
