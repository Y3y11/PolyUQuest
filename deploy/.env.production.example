# Copy to a secret-managed location outside Git before deployment.
BACKEND_IMAGE=polyuquest-backend:0.1.0
BACKEND_RUNTIME_PROFILE=remote
FRONTEND_IMAGE=polyuquest-frontend:0.1.0
API_PORT=8000
FRONTEND_PORT=3000

NEO4J_PASSWORD=replace-with-a-long-random-password
API_AUTH_KEYS=replace-with-hash-only-record-generated-by-security-cli

LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
GENERATION_MODEL=deepseek-v4-flash

EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=replace-with-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

CORS_ALLOW_ORIGINS=https://knowledge.example.com
# Host path to the protected raw frontend reader key. On Linux use root:10001
# ownership and mode 0440; Compose mounts it at /run/secrets/bff_backend_api_key.
BFF_BACKEND_API_KEY_FILE=/etc/polyuquest/secrets/frontend-reader.key
BFF_ALLOWED_ORIGINS=https://knowledge.example.com
BFF_MAX_REQUEST_BYTES=65536
BFF_UPSTREAM_TIMEOUT_SECONDS=120
AGENT_RUN_WORKER_POLL_SECONDS=0.25
AGENT_RUN_LEASE_SECONDS=120
AGENT_RUN_MAX_ATTEMPTS=2
AGENT_RUN_RETRY_BASE_SECONDS=2
AGENT_RUN_RETENTION_DAYS=7
AGENT_RUN_QUEUE_WARN_SECONDS=30
AGENT_RUN_QUEUE_CRITICAL_SECONDS=120
AGENT_RUN_ADMISSION_ENABLED=true
AGENT_RUN_ADMISSION_MAX_ACTIVE=100
AGENT_RUN_ADMISSION_MAX_WAITING=80
AGENT_RUN_ADMISSION_RETRY_AFTER_SECONDS=5
AGENT_RUN_ADMISSION_WARN_RATIO=0.8
AGENT_RUN_BUDGET_MAX_ITERATIONS=5
AGENT_RUN_BUDGET_MAX_PAGES=10
AGENT_RUN_BUDGET_MAX_SECONDS=120
RUNTIME_METRICS_ENABLED=true
RUNTIME_METRICS_CACHE_TTL_SECONDS=5
RUNTIME_METRICS_TELEMETRY_WINDOW_HOURS=24
RUNTIME_METRICS_WORKER_LIMIT=100
OTEL_TRACING_MODE=disabled
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_EXPORTER_OTLP_ENDPOINT=
# Inject exporter credentials through a deployment secret, never commit them.
OTEL_EXPORTER_OTLP_HEADERS=
TRACE_BACKEND_ENABLED=false
TRACE_BACKEND_URL=http://tempo:3200
TRACE_BACKEND_TIMEOUT_SECONDS=3
TRACE_BACKEND_MAX_RESPONSE_BYTES=2097152
TRACE_BACKEND_MAX_SPANS=500
AGENT_RUN_EVENT_POLL_SECONDS=0.25
AGENT_RUN_SSE_KEEPALIVE_SECONDS=15
WORKER_SHUTDOWN_GRACE_SECONDS=30
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=2g
NEO4J_PAGECACHE=1g
