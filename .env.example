# === LLM API Keys ===
DEEPSEEK_API_KEY=sk-xxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=sk-xxxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SILICONFLOW_API_KEY=sk-xxxxx
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# Default LLM provider: deepseek | qwen | siliconflow
LLM_PROVIDER=siliconflow
# Optional answer-generation override, for example: deepseek-v4-flash
GENERATION_MODEL=

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=agent_rag_polyu

# === Qdrant ===
QDRANT_HOST=localhost
QDRANT_PORT=6333

# === Embedding ===
# Providers: local | siliconflow | api
#   local       — BGE-M3 via sentence-transformers (needs GPU or patience)
#   siliconflow — BGE-M3 via SiliconFlow API (recommended, fast & cheap)
#   api         — generic OpenAI-compatible embedding endpoint
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=Pro/BAAI/bge-m3
EMBEDDING_DIM=1024
# Only needed when EMBEDDING_PROVIDER=api (non-SiliconFlow generic endpoint)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# === Crawler ===
CRAWL_DELAY_SECONDS=1.5
# Firecrawl API key (optional, enables JS-rendered scraping)
# Get one at https://www.firecrawl.dev/ (500 free credits)
FIRECRAWL_API_KEY=

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8000
# Keep code reload development-only. Production starts should use false.
API_RELOAD=false

# === API security ===
# Production refuses to start with API_AUTH_MODE=disabled.
APP_ENVIRONMENT=development
API_AUTH_MODE=disabled
# Hash-only comma-separated records: key_id:reader|operator|admin:sha256_hex
# Generate a one-time raw key + safe record with:
# python -m agent_rag.security.cli --key-id service-admin --role admin
API_AUTH_KEYS=
SECURITY_AUDIT_PATH=data/runtime/security_audit.sqlite3
SECURITY_AUDIT_RETENTION_DAYS=90

# === CORS ===
# 逗号分隔的 origin 白名单。带凭证的跨域请求禁止使用 "*"。
# 开发默认已覆盖 localhost:5173/3000/8080 (及其 127.0.0.1 变体)。
# 生产示例: CORS_ALLOW_ORIGINS=https://app.polyu.edu.hk,https://admin.polyu.edu.hk
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8080
# 可选：正则匹配一族 origin（多子域场景）。非空时覆盖 CORS_ALLOW_ORIGINS。
# 示例: CORS_ALLOW_ORIGIN_REGEX=^https://([a-z0-9-]+\.)?polyu\.edu\.hk$
CORS_ALLOW_ORIGIN_REGEX=
# 是否允许 credentialed 跨域请求（cookie / HTTP Auth / TLS client cert）。
# 对应 fetch 的 credentials: "include" 模式；开启后 origin 禁止通配。
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
# Agent exploration writes fetched trusted pages and DOM blocks through an
# audited Patch by default. Set false for a strictly read-only deployment.
AGENT_ALLOW_PERSISTENCE=true
# Durable Observation/Patch ledger used for restart recovery.
AGENT_LEDGER_PATH=data/runtime/agent_ledger.sqlite3
AGENT_REPAIR_ON_STARTUP=true
AGENT_REPAIR_MAX_PATCHES=25
AGENT_PATCH_MAX_ATTEMPTS=5
# Decouple the answer path from embedding and graph/vector writes.
AGENT_ASYNC_INDEXING=true
INDEX_WORKER_ENABLED=true
INDEX_WORKER_POLL_SECONDS=0.5
INDEX_WORKER_LEASE_SECONDS=120
INDEX_JOB_MAX_ATTEMPTS=5
INDEX_JOB_RETRY_BASE_SECONDS=2
INDEX_JOB_RETRY_MAX_SECONDS=300
INDEX_JOB_RETENTION_DAYS=30
# Maintain indexed web pages even when no user query triggers exploration.
FRESHNESS_WORKER_ENABLED=true
FRESHNESS_WORKER_POLL_SECONDS=5
FRESHNESS_WORKER_LEASE_SECONDS=120
