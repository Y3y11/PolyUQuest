# Server-only Next.js BFF configuration. Do not use NEXT_PUBLIC_* for these values.
BACKEND_API_URL=http://127.0.0.1:8000/api

# Local development may leave this empty when FastAPI uses API_AUTH_MODE=disabled.
# When local FastAPI authentication is enabled, use a short-lived reader key.
BFF_BACKEND_API_KEY=

BFF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BFF_MAX_REQUEST_BYTES=65536
BFF_UPSTREAM_TIMEOUT_SECONDS=120
